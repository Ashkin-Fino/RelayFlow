# Copy to docker.env and replace the example values before starting the stack.
RELAY_DB_USER=relayflow
RELAY_DB_PASSWORD=replace-with-a-local-database-password
RELAY_DEMO_TOKEN=replace-with-a-long-random-demo-token

# These are optional. The defaults use the bundled mock provider.
API_PORT=8082
FRONTEND_PORT=8081
RELAY_AI_MODEL=alpha-small
# For a real OpenAI-compatible provider, configure these in docker.env:
# RELAY_AI_BASE_URL=https://provider.example/v1
# RELAY_AI_API_KEY=your-provider-key
# RELAY_AI_MODEL=provider-model-id
